# Django reads these values from the process environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production HTTPS defaults become active automatically when DEBUG is false.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=Lax

# Production database. Omit DATABASE_URL to use local SQLite.
DATABASE_URL=postgresql://notes:change-me@localhost:5432/notes
DATABASE_CONN_MAX_AGE=60

# Docker Compose database defaults. Use a strong password outside local development.
POSTGRES_DB=notes
POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me

# Copy this entry to frontend/.env.local when needed.
VITE_API_BASE_URL=http://127.0.0.1:8000
