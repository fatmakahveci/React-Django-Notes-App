# Select exactly one explicit profile outside manage.py development commands:
# config.settings_development, config.settings_test, config.settings_staging,
# or config.settings_production.
DJANGO_SETTINGS_MODULE=config.settings_development
# Django reads these values from the process environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_RATE_LIMIT_ANONYMOUS=60/minute
DJANGO_RATE_LIMIT_USER=300/minute
DJANGO_RATE_LIMIT_ADMIN=600/minute
DJANGO_RATE_LIMIT_SECURITY_SCANNER=1200/minute
DJANGO_RATE_LIMIT_AUTHENTICATION=10/minute
# Optional: use a long random value in the X-Security-Scanner-Key request header.
DJANGO_SECURITY_SCANNER_KEY=
# Set to the exact number of trusted reverse proxies in front of Django.
DJANGO_NUM_PROXIES=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# HTTPS, secure-cookie, HSTS, and debug behavior belongs to the selected profile.
JWT_COOKIE_SAMESITE=Lax
JWT_ACCESS_TOKEN_MINUTES=5
JWT_REFRESH_TOKEN_DAYS=7

# Production database. Omit DATABASE_URL to use local SQLite.
DATABASE_URL=postgresql://notes:change-me@localhost:5432/notes
DATABASE_CONN_MAX_AGE=60

# Shared cache for multi-worker rate-limit counters. Omit locally to use LocMem.
DJANGO_CACHE_URL=redis://localhost:6379/0
DJANGO_CACHE_KEY_PREFIX=notes
# Increment on deployment when the entire logical cache namespace must expire.
DJANGO_CACHE_VERSION=1
DJANGO_CACHE_DEFAULT_TIMEOUT=300
# Tests use LocMem unless Redis integration is explicitly requested.
DJANGO_TEST_USE_REDIS=false

# Observability. APP_RELEASE should be an immutable commit SHA or image tag.
APP_RELEASE=local
DJANGO_LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Docker Compose database defaults. Use a strong password outside local development.
POSTGRES_DB=notes
POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me

# Copy this entry to frontend/.env.local when needed.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_TIMEOUT_MS=10000

# Production deployment keeps secrets in .env.production on the host. These
# image values are generated automatically in .env.release; do not edit them.
BACKEND_IMAGE=ghcr.io/owner/react-django-notes-app-backend:sha-commit
FRONTEND_IMAGE=ghcr.io/owner/react-django-notes-app-frontend:sha-commit
